{
  "entities": {
    "User": {
      "title": "User",
      "description": "Akun nasabah dan profil pengelola platform emas IndoGold",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "nama": { "type": "string" },
        "email": { "type": "string" },
        "sandi": { "type": "string" },
        "saldo": { "type": "number", "description": "Saldo kas rupiah riil nasabah" },
        "saldoEmas": { "type": "number", "description": "Total gram emas nasabah" },
        "kodeRef": { "type": "string" },
        "dirujukOleh": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "terakhirKlaimDividen": { "type": "string" }
      },
      "required": ["uid", "nama", "email", "saldo", "saldoEmas"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Data transaksi riil setoran kas, penarikan, dan jual beli emas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userNama": { "type": "string" },
        "jenis": {
          "type": "string",
          "enum": ["deposit", "tarik", "beli_emas", "jual_emas", "dividen_harian", "bonus_referral"]
        },
        "jumlah": { "type": "number" },
        "gram": { "type": "number" },
        "brand": { "type": "string" },
        "hargaPerGram": { "type": "number" },
        "metode": { "type": "string" },
        "namaPengirim": { "type": "string" },
        "nomorPengirim": { "type": "string" },
        "namaTujuan": { "type": "string" },
        "nomorTujuan": { "type": "string" },
        "buktiFoto": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["menunggu", "berhasil", "ditolak"]
        },
        "waktu": { "type": "string" },
        "catatan": { "type": "string" }
      },
      "required": ["id", "userId", "jenis", "jumlah", "status", "waktu"]
    },
    "SupportRoom": {
      "title": "SupportRoom",
      "description": "Kamar percakapan live chat antara nasabah dan tim admin CS",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "string" },
        "lastSenderRole": { "type": "string", "enum": ["user", "admin"] },
        "unreadByAdmin": { "type": "number" },
        "unreadByUser": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "userName", "lastMessage", "updatedAt"]
    },
    "SupportMessage": {
      "title": "SupportMessage",
      "description": "Pesan chat riil antara pengguna dan admin backoffice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "senderRole": { "type": "string", "enum": ["user", "admin"] },
        "senderName": { "type": "string" },
        "senderId": { "type": "string" },
        "pesan": { "type": "string" },
        "waktu": { "type": "string" },
        "dibaca": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "senderRole", "pesan", "waktu", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Koleksi akun nasabah dan data aset tersimpan"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Koleksi riwayat transaksi setor, tarik, dan beli/jual emas"
    },
    "/support_rooms/{roomId}": {
      "schema": "SupportRoom",
      "description": "Koleksi percakapan/thread bantuan nasabah"
    },
    "/support_messages/{messageId}": {
      "schema": "SupportMessage",
      "description": "Koleksi pesan individual obrolan live chat"
    }
  }
}
